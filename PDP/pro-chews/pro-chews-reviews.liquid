{%- comment -%}
  REVIEWS_PENDING_JUDGEME
  Section shell is rebranded for Pro Chews (handle, header copy, button color, accents).
  Testimonial content below is still food-based until judge.me syndication is wired in.
  Swap testimonials via theme editor or judge.me feed before launching chews.
{%- endcomment -%}

{%- liquid
  assign eyebrow    = section.settings.eyebrow
  assign heading    = section.settings.heading
  assign subheading = section.settings.subheading
  assign bg_color   = section.settings.background_color
  assign cta_text   = section.settings.cta_text
  assign cta_url    = section.settings.cta_url
  assign guarantee  = section.settings.guarantee_text
-%}

{{ 'fdr-trial-pdp.css' | asset_url | stylesheet_tag }}

<style>
  /* ══ SCROLLING REVIEWS ══ */
  .pc-rv-scroll-track {
    overflow:hidden;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:none;
    margin:0 -72px;
    padding:0;
  }
  .pc-rv-scroll-track::-webkit-scrollbar { display:none; }
  .pc-rv-scroll {
    display:flex;
    gap:20px;
    padding:8px 20px 20px;
    width:max-content;
    animation:pc-rv-auto-scroll 38s linear infinite;
  }
  .pc-rv-scroll:hover { animation-play-state:paused; }
  @keyframes pc-rv-auto-scroll {
    0%   { transform:translateX(0); }
    100% { transform:translateX(-50%); }
  }
  .pc-rv-card {
    width:272px;
    flex-shrink:0;
    background:#fff;
    border-radius:var(--fdr-radius-lg);
    overflow:hidden;
    border:1px solid rgba(0,80,5,.1);
    display:flex;
    flex-direction:column;
    box-shadow:0 4px 20px rgba(0,80,5,.08);
    transition:transform .2s;
  }
  .pc-rv-card:hover { transform:translateY(-3px); }
  .pc-rv-card-img {
    width:100%;
    height:190px;
    overflow:hidden;
  }
  .pc-rv-card-img img {
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center center;
  }
  .pc-rv-card-body { padding:20px 18px 18px; display:flex; flex-direction:column; gap:7px; flex:1; }
  /* Decorative open-quote accent — gives text-only cards a deliberate top anchor */
  .pc-rv-card-body::before {
    content:'\201C';
    font-family:Georgia, serif;
    font-size:44px;
    line-height:0.6;
    color:var(--fdr-amber);
    opacity:.45;
    margin-bottom:2px;
  }
  .pc-rv-stars { color:var(--fdr-amber); font-size:12px; letter-spacing:1px; }
  .pc-rv-quote { font-size:14px; font-weight:800; color:var(--fdr-ink); line-height:1.35; font-style:italic; }
  .pc-rv-title { font-size:13px; font-weight:800; color:var(--fdr-ink); line-height:1.35; }
  .pc-rv-text  { font-size:12px; color:var(--fdr-muted); line-height:1.5; }
  /* Author pinned to the bottom with a hairline divider so ragged text lengths align */
  .pc-rv-author { font-size:11px; font-weight:700; color:var(--fdr-forest); text-transform:uppercase; letter-spacing:.04em; margin-top:auto; padding-top:12px; border-top:1px solid rgba(0,80,5,.1); }

  /* Subheading override */
  .fdr-sub--normal { font-style: normal; }

  /* CTA area */
  .pc-reviews-cta {
    text-align:center;
    margin-top:40px;
  }
  /* Override shared theme pill — chews page uses orange, not brand green */
  .section-pc-reviews .fdr-cta-pill,
  .section-pc-reviews .fdr-cta-pill--primary { background: #E85F2E !important; color: #fff !important; }
  .section-pc-reviews .fdr-cta-pill:hover { background: #D24E20 !important; }

  /* Responsive */
  @media (max-width:768px) {
    .pc-rv-scroll-track { margin:0 -20px; }
    .pc-rv-card { width:240px; }
    .pc-rv-card-img { height:160px; }
  }
  @media (max-width:480px) {
    .pc-rv-card { width:220px; }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .pc-rv-scroll {
      animation:none;
      overflow-x:auto;
    }
  }
</style>

<div class="fdr-sec fdr-sec--{{ bg_color }}">
  {%- if eyebrow != blank -%}
    <p class="fdr-eyebrow">{{ eyebrow | escape }}</p>
  {%- endif -%}
  {%- if heading != blank -%}
    <h2 class="fdr-h2">{{ heading | escape }}</h2>
  {%- endif -%}
  {%- if subheading != blank -%}
    <p class="fdr-sub fdr-sub--normal">{{ subheading | escape }}</p>
  {%- endif -%}

  <div class="pc-rv-scroll-track">
    <div class="pc-rv-scroll">
      <!-- Set 1 -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <!-- PLACEHOLDER REVIEW — fictional, not a real customer. Replace on judge.me sync. -->
          <div class="pc-rv-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="pc-rv-card-img">
                <img
                  src="{{ block.settings.image }}"
                  alt="{{ block.settings.author | escape }}"
                  loading="lazy"
                  width="300"
                  height="300"
                  style="object-position: {{ block.settings.image_position }};"
                >
              </div>
            {%- endif -%}
            <div class="pc-rv-card-body">
              <div class="pc-rv-stars">
                {%- assign star_count = block.settings.stars -%}
                {%- for i in (1..star_count) -%}&#9733;{%- endfor -%}
              </div>
              {%- if block.settings.title != blank -%}
                <div class="pc-rv-quote">&ldquo;{{ block.settings.title | escape }}&rdquo;</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="pc-rv-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if block.settings.author != blank -%}
                <div class="pc-rv-author">
                  {{ block.settings.author | escape }}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Set 2 (duplicate for seamless loop) -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <!-- PLACEHOLDER REVIEW — fictional, not a real customer. Replace on judge.me sync. -->
          <div class="pc-rv-card" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              <div class="pc-rv-card-img">
                <img
                  src="{{ block.settings.image }}"
                  alt=""
                  loading="lazy"
                  width="300"
                  height="300"
                  style="object-position: {{ block.settings.image_position }};"
                >
              </div>
            {%- endif -%}
            <div class="pc-rv-card-body">
              <div class="pc-rv-stars">
                {%- assign star_count = block.settings.stars -%}
                {%- for i in (1..star_count) -%}&#9733;{%- endfor -%}
              </div>
              {%- if block.settings.title != blank -%}
                <div class="pc-rv-quote">&ldquo;{{ block.settings.title | escape }}&rdquo;</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="pc-rv-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if block.settings.author != blank -%}
                <div class="pc-rv-author">
                  {{ block.settings.author | escape }}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if cta_text != blank -%}
    <div class="pc-reviews-cta">
      <a href="#buy-box" class="fdr-cta-pill fdr-cta-pill--primary">
        {{ cta_text | escape }}
        <svg class="fdr-cta-arrow" width="18" height="13" viewBox="0 0 18 13" fill="none" aria-hidden="true"><path d="M1 6.5H17M17 6.5L11 1M17 6.5L11 12" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      {%- if guarantee != blank -%}
        <p class="fdr-cta-guarantee">{{ guarantee | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

