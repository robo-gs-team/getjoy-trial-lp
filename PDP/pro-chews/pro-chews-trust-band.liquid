
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" media="print" onload="this.media='all'">
{{ 'fdr-trial-pdp.css' | asset_url | stylesheet_tag }}

<style>
  /* ─── TRUST BAND ─── */
  .pc-trust-band {
    background:var(--fdr-forest);
    display:flex;
  }
  .pc-trust-band__cell {
    flex:1;
    display:flex; align-items:center; justify-content:center; gap:10px;
    padding:15px 20px;
    border-right:1px solid rgba(255,255,255,0.12);
  }
  .pc-trust-band__cell:last-child { border-right:none; }
  .pc-trust-band__icon {
    width:30px; height:30px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
  }
  .pc-trust-band__icon svg { width:20px; height:20px; }
  .pc-trust-band__fa-icon {
    font-size:18px; color:#fff; width:20px; text-align:center; flex-shrink:0;
  }
  .pc-trust-band__label {
    font-family:var(--fdr-font-body);
    font-size:12.5px; font-weight:700;
    color:#fff; line-height:1.2;
    white-space:nowrap;
  }
  .pc-trust-band__cell--hide-mobile {
    display:flex;
  }

  /* ══ TRUST BAND MARQUEE ══ */
  .pc-trust-band__track {
    overflow:hidden;
    width:100%;
    display:flex;
  }
  .pc-trust-band__inner {
    display:flex;
    width:max-content;
    animation:pc-tb-scroll 24s linear infinite;
  }
  .pc-trust-band__inner .pc-trust-band__cell {
    flex-shrink:0;
    min-width:280px;
  }
  @keyframes pc-tb-scroll {
    0%   { transform:translateX(0); }
    100% { transform:translateX(-50%); }
  }
  .pc-trust-band__track:hover .pc-trust-band__inner { animation-play-state:paused; }

  @media (max-width: 768px) {
    .pc-trust-band__cell--hide-mobile { display:none; }
    .pc-trust-band__inner .pc-trust-band__cell { min-width:240px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pc-trust-band__inner { animation:none; }
  }
</style>

<div class="pc-trust-band">
  <div class="pc-trust-band__track">
    {% for i in (1..2) %}
    <div class="pc-trust-band__inner"{% if i == 2 %} aria-hidden="true"{% endif %}>
      {% for block in section.blocks %}
        {%- liquid
          assign label      = block.settings.label
          assign icon_class = block.settings.icon_class
          assign icon_svg   = block.settings.icon_svg
          assign hide_mobile = block.settings.hide_mobile
        -%}
        <div class="pc-trust-band__cell{% if hide_mobile %} pc-trust-band__cell--hide-mobile{% endif %}" {{ block.shopify_attributes }}>
          {%- if icon_class != blank -%}
            <i class="{{ icon_class | escape }} pc-trust-band__fa-icon" aria-hidden="true"></i>
          {%- elsif icon_svg != blank -%}
            <div class="pc-trust-band__icon">{{ icon_svg }}</div>
          {%- endif -%}
          <span class="pc-trust-band__label">{{ label | escape }}</span>
        </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Pro Chews Trust Band",
  "tag": "section",
  "class": "section-pc-trust-band",
  "settings": [
    {
      "type": "select",
      "id": "background_color",
      "label": "Background color",
      "options": [
        { "value": "core-forest", "label": "Forest" },
        { "value": "core", "label": "Green" }
      ],
      "default": "core-forest"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Crafted in the USA"
        },
        {
          "type": "text",
          "id": "icon_class",
          "label": "FontAwesome icon class",
          "info": "e.g. fa-solid fa-flag — browse at fontawesome.com/icons (free only)",
          "default": "fa-solid fa-flag"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Icon SVG fallback",
          "info": "Used only if FontAwesome class above is blank. Legacy field."
        },
        {
          "type": "checkbox",
          "id": "hide_mobile",
          "label": "Hide on mobile",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pro Chews Trust Band",
      "category": "Landing Page",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "label": "Made in the USA",
            "icon_class": "fa-solid fa-flag"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "3 Billion Live CFU",
            "icon_class": "fa-solid fa-bacteria"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "All Life Stages",
            "icon_class": "fa-solid fa-paw"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "Belly Biotics™",
            "icon_class": "fa-solid fa-seedling"
          }
        }
      ]
    }
  ]
}
{% endschema %}
