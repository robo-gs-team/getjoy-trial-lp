{{ 'fdr-trial-pdp.css' | asset_url | stylesheet_tag }}

<style>
  /* ─── PRO CHEWS EXPERTS ─── */
  #pc-experts {
    background: var(--pce-bg, var(--pc-cream, #FBF3E8));
    padding: 56px 24px;
  }
  #pc-experts .pce-header {
    text-align: center;
    max-width: 580px;
    margin: 0 auto 36px;
  }
  #pc-experts .pce-eyebrow {
    font-family: var(--fdr-font-body, system-ui, sans-serif);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #E85F2E;
    margin-bottom: 6px;
  }
  #pc-experts .pce-h2 {
    font-family: var(--fdr-font-heading, Georgia, serif);
    font-size: clamp(26px, 3.5vw, 38px);
    font-weight: 900;
    color: #1C5236;
    line-height: 1.1;
    margin: 0 0 10px;
  }
  #pc-experts .pce-sub {
    font-family: var(--fdr-font-serif, Georgia, serif);
    font-style: italic;
    font-size: 15.5px;
    color: var(--pc-muted, #8a8270);
    line-height: 1.6;
    margin: 0;
  }

  /* Desktop grid */
  #pc-experts .pce-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    max-width: 1080px;
    margin: 0 auto;
  }
  #pc-experts .pce-card {
    background: #ffffff;
    border: 0.5px solid #E7DECC;
    border-radius: 14px;
    overflow: hidden;
  }
  #pc-experts .pce-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: top center;
    display: block;
    background: #f0ebe0;
  }
  #pc-experts .pce-body {
    padding: 14px 14px 18px;
  }
  #pc-experts .pce-card-eyebrow {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #E85F2E;
    margin-bottom: 3px;
  }
  #pc-experts .pce-name {
    font-size: 14px;
    font-weight: 700;
    color: #1C5236;
    margin-bottom: 3px;
    line-height: 1.2;
  }
  #pc-experts .pce-credential {
    font-size: 11px;
    color: #8a8270;
    margin-bottom: 8px;
    line-height: 1.4;
  }
  #pc-experts .pce-statement {
    font-size: 12px;
    color: #3E382B;
    line-height: 1.6;
  }
  #pc-experts .pce-statement a,
  #pc-experts .pce-statement a:visited {
    color: #3E382B;
    text-decoration: none;
  }

  /* Mobile rows */
  @media (max-width: 767px) {
    #pc-experts { padding: 40px 16px; }
    #pc-experts .pce-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    #pc-experts .pce-card {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 14px;
      padding: 14px;
      border-radius: 12px;
    }
    #pc-experts .pce-photo {
      width: 64px;
      height: 64px;
      flex: none;
      border-radius: 8px;
      aspect-ratio: unset;
    }
    #pc-experts .pce-body {
      padding: 0;
      flex: 1;
      min-width: 0;
    }
  }
</style>

{%- assign bg = section.settings.bg_color | default: '#FBF3E8' -%}

<div id="pc-experts" style="--pce-bg: {{ bg }};">
  <div class="pce-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pce-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="pce-h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="pce-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="pce-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'expert' -%}
        <div class="pce-card" {{ block.shopify_attributes }}>
          {%- if block.settings.photo != blank -%}
            <img class="pce-photo"
                 src="{{ block.settings.photo | image_url: width: 400 }}"
                 alt="{{ block.settings.name | escape }}"
                 loading="lazy"
                 width="400"
                 height="400">
          {%- else -%}
            <div class="pce-photo" aria-hidden="true"></div>
          {%- endif -%}
          <div class="pce-body">
            {%- if block.settings.role_eyebrow != blank -%}
              <p class="pce-card-eyebrow">{{ block.settings.role_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.name != blank -%}
              <p class="pce-name">{{ block.settings.name | escape }}</p>
            {%- endif -%}
            {%- if block.settings.credential != blank -%}
              <p class="pce-credential">{{ block.settings.credential | escape }}</p>
            {%- endif -%}
            {%- if block.settings.statement != blank -%}
              <p class="pce-statement">{{ block.settings.statement | replace: '™', '<sup>™</sup>' }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

