{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign body_1 = section.settings.body_1
  assign body_2 = section.settings.body_2
  assign cta_label = section.settings.cta_label
  assign guarantee_text = section.settings.guarantee_text
-%}

{{ 'fdr-trial-pdp.css' | asset_url | stylesheet_tag }}

<style>
  /* ── Why $9.99 Banner ── */
  .pc-why-banner {
    background: #FCF6E8;
    padding: 64px 20px;
  }
  .pc-why-banner__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .pc-why-banner__heading {
    font-family: var(--fdr-font-heading);
    font-weight: 900;
    font-size: clamp(30px, 3.5vw, 48px);
    letter-spacing: -0.03em;
    text-transform: none;
    color: var(--fdr-forest);
    opacity: 1;
    margin-bottom: 10px;
    line-height: 1.1;
  }
  .pc-why-banner__sub {
    font-family: var(--fdr-font-body);
    font-weight: 500;
    font-size: clamp(15px, 1.4vw, 18px);
    color: var(--fdr-forest);
    opacity: 0.65;
    letter-spacing: 0;
    line-height: 1.5;
    margin-bottom: 24px;
  }
  .pc-why-banner__body {
    font-family: var(--fdr-font-body);
    font-size: 14px;
    color: var(--fdr-ink);
    line-height: 1.7;
    margin-bottom: 16px;
    text-align: left;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .pc-why-banner__cta-wrap { margin-bottom: 10px; }

  @media (max-width: 768px) {
    .pc-why-banner { padding: 48px 20px; }
    .pc-why-banner__sub { font-size: 22px; }
  }
</style>

<div class="pc-why-banner">
  <div class="pc-why-banner__inner">
    {% if heading != blank %}
      <h2 class="pc-why-banner__heading">{{ heading | escape }}</h2>
    {% endif %}
    {% if subheading != blank %}
      <p class="pc-why-banner__sub">{{ subheading | escape }}</p>
    {% endif %}
    {% if body_1 != blank %}
      <p class="pc-why-banner__body">{{ body_1 | escape }}</p>
    {% endif %}
    {% if body_2 != blank %}
      <p class="pc-why-banner__body">{{ body_2 | escape }}</p>
    {% endif %}
    {% if cta_label != blank %}
      <div class="pc-why-banner__cta-wrap">
        <a href="#buy-box" class="fdr-cta-pill fdr-cta-pill--primary">
          {{ cta_label | escape }}
          <svg width="18" height="13" viewBox="0 0 18 13" fill="none" aria-hidden="true"><path d="M1 6.5H17M17 6.5L11 1M17 6.5L11 12" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    {% endif %}
    {% if guarantee_text != blank %}
      <p class="fdr-cta-guarantee">{{ guarantee_text | escape }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Pro Chews Why Banner",
  "tag": "section",
  "class": "section-pc-why-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why we built the chew"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real gut support, made by a dog food company."
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Body paragraph 1",
      "default": "Every owner we talked to had a cabinet of half-empty supplement bottles. The probiotic was always the one they forgot. So we built the daily chew that does what the whole shelf does, with the same Belly Biotics system that is in the food."
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Body paragraph 2",
      "default": "One chew a day, on top of whatever your dog already eats. Skip, pause, or cancel anytime. Your call, every month."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Add to Cart \u2014 $25.99"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "30-day money-back guarantee. If it doesn't work, it's completely free."
    }
  ],
  "presets": [
    {
      "name": "Pro Chews Why Banner",
      "category": "Landing Page"
    }
  ]
}
{% endschema %}
