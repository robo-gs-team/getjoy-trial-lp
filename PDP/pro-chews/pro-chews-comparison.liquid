{%- liquid
  assign eyebrow       = section.settings.eyebrow
  assign heading       = section.settings.heading
  assign subheading    = section.settings.subheading
  assign bridge_text   = section.settings.bridge_text
  assign col_comp1_label = section.settings.col_comp1_label
  assign col_comp1_sub   = section.settings.col_comp1_sub
  assign col_comp2_label = section.settings.col_comp2_label
  assign col_comp2_sub   = section.settings.col_comp2_sub
  assign col_gj_label    = section.settings.col_gj_label
  assign col_gj_sub      = section.settings.col_gj_sub
  assign col_mobile_comp_label = section.settings.col_mobile_comp_label
  assign col_mobile_gj_label   = section.settings.col_mobile_gj_label
  assign col_mobile_gj_sub     = section.settings.col_mobile_gj_sub
  assign cta_text      = section.settings.cta_text
  assign cta_url       = section.settings.cta_url
  assign guarantee     = section.settings.guarantee_text
-%}

{{ 'fdr-trial-pdp.css' | asset_url | stylesheet_tag }}

<style>
  /* ── Pro Chews Comparison ── */
  .pc-cmp { background: var(--pc-cream, #FBF3E8); padding: 80px 20px; }
  .pc-cmp .pc-eyebrow {
    font-family: var(--fdr-font-body, system-ui, sans-serif);
    font-weight: 800; font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
    color: var(--pc-orange, #E85F2E); text-align: center; margin: 0 0 14px;
  }
  .pc-cmp .pc-h2 {
    font-family: var(--fdr-font-heading, Georgia, serif); font-weight: 900;
    font-size: clamp(26px, 3.5vw, 38px); color: var(--pc-forest, #1C5236);
    letter-spacing: -1px; line-height: 1.1; text-align: center; margin: 0 0 12px;
  }
  .pc-cmp .pc-sub {
    font-family: var(--fdr-font-serif, Georgia, serif); font-style: italic;
    font-size: 15.5px; color: var(--pc-muted, #8a8270); line-height: 1.6;
    text-align: center; max-width: 640px; margin: 0 auto;
  }
  .pc-cmp-bridge {
    text-align: center; max-width: 640px; margin: 28px auto 0;
    font-family: var(--fdr-font-body, system-ui, sans-serif);
    font-size: 14px; color: var(--pc-forest, #1C5236); line-height: 1.6; font-weight: 500;
  }

  .pc-cmp-wrap {
    max-width: 900px; margin: 40px auto 0;
    border-radius: 14px; overflow: hidden;
    border: 1.5px solid var(--pc-line, #E7DECC); background: #fff;
  }
  .pc-cmp-table { width: 100%; border-collapse: collapse; table-layout: fixed; }

  .pc-cmp-wrap--desktop { display: block; }
  .pc-cmp-wrap--desktop .pc-cmp-c-attr  { width: 36%; }
  .pc-cmp-wrap--desktop .pc-cmp-c-comp1 { width: 20%; }
  .pc-cmp-wrap--desktop .pc-cmp-c-comp2 { width: 20%; }
  .pc-cmp-wrap--desktop .pc-cmp-c-gj    { width: 24%; }
  .pc-cmp-wrap--mobile  { display: none; }
  .pc-cmp-wrap--mobile .pc-cmp-c-attr  { width: 50%; }
  .pc-cmp-wrap--mobile .pc-cmp-c-comp  { width: 25%; }
  .pc-cmp-wrap--mobile .pc-cmp-c-gj    { width: 25%; }

  .pc-cmp-th-empty { background: var(--pc-forest, #1C5236); }
  .pc-cmp-th-comp { background: #2a3a2a; padding: 14px 12px; text-align: center; vertical-align: middle; }
  .pc-cmp-th-gj {
    background: var(--pc-forest, #1C5236); padding: 14px 12px;
    text-align: center; vertical-align: middle;
    border-left: 2px solid var(--pc-orange, #E85F2E);
  }
  .pc-cmp-th-label {
    display: block; font-family: var(--fdr-font-body, system-ui, sans-serif);
    font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: .08em;
    color: rgba(255,255,255,.60);
  }
  .pc-cmp-th-label--gj { color: #FCF6E8; font-size: 12px; }
  .pc-cmp-th-sub {
    display: block; font-family: var(--fdr-font-body, system-ui, sans-serif);
    font-weight: 400; font-size: 10px; color: rgba(255,255,255,.30); margin-top: 3px;
  }
  .pc-cmp-th-sub--gj { color: rgba(255,255,255,.40); }

  .pc-cmp-wrap--mobile .pc-cmp-th-empty { padding: 12px 14px; }
  .pc-cmp-wrap--mobile .pc-cmp-th-comp  { padding: 12px 8px; border-right: 1px solid rgba(255,255,255,.08); }
  .pc-cmp-wrap--mobile .pc-cmp-th-comp .pc-cmp-th-label  { font-size: 10px; letter-spacing: .06em; }
  .pc-cmp-wrap--mobile .pc-cmp-th-gj    { padding: 12px 8px; }
  .pc-cmp-wrap--mobile .pc-cmp-th-gj .pc-cmp-th-label    { font-size: 10px; letter-spacing: .06em; }

  .pc-cmp-table tbody tr { border-bottom: 1px solid var(--pc-line, #E7DECC); }
  .pc-cmp-table tbody tr:last-child { border-bottom: none; }
  .pc-cmp-table tbody tr:nth-child(odd)  td { background: #fff; }
  .pc-cmp-table tbody tr:nth-child(even) td { background: rgba(252,234,224,.5); }
  .pc-cmp-table tbody tr:nth-child(even) td.pc-cmp-val-gj { background: rgba(28,82,54,.06); }

  .pc-cmp-attr {
    padding: 14px 16px; font-family: var(--fdr-font-body, system-ui, sans-serif);
    font-weight: 500; font-size: 14px; color: var(--pc-forest, #1C5236); text-align: left;
  }
  .pc-cmp-val-comp {
    padding: 14px 12px; text-align: center; vertical-align: middle;
    font-family: var(--fdr-font-body, system-ui, sans-serif);
    font-weight: 400; font-size: 14px; color: var(--pc-muted, #8a8270);
  }
  .pc-cmp-val-gj {
    padding: 14px 12px; text-align: center; vertical-align: middle;
    font-family: var(--fdr-font-body, system-ui, sans-serif);
    font-weight: 700; font-size: 14px; color: var(--pc-forest, #1C5236);
    border-left: 2px solid rgba(232,95,46,.25);
  }
  .pc-cmp-win { color: var(--pc-forest, #1C5236); font-weight: 700; }
  .pc-cmp-check { color: var(--pc-orange, #E85F2E); font-size: 18px; font-weight: 700; }
  .pc-cmp-x     { color: var(--pc-muted, #8a8270); font-size: 15px; opacity: .40; }
  .pc-cmp-tilde { color: var(--pc-muted, #8a8270); font-size: 18px; opacity: .50; }

  .pc-cmp-wrap--mobile .pc-cmp-attr     { padding: 12px 14px; font-size: 13px; font-weight: 400; line-height: 1.35; }
  .pc-cmp-wrap--mobile .pc-cmp-val-comp { padding: 12px 8px; }
  .pc-cmp-wrap--mobile .pc-cmp-val-gj   { padding: 12px 8px; border-left: 2px solid rgba(232,95,46,.20); }

  @media (max-width: 768px) {
    .pc-cmp-wrap--desktop { display: none; }
    .pc-cmp-wrap--mobile  { display: block; }
  }

  .pc-cmp-cta { text-align: center; margin-top: 40px; }
  .pc-cmp-cta .pc-cta-pill {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--pc-orange, #E85F2E); color: #fff;
    padding: 14px 26px; border-radius: 99px;
    font-weight: 900; font-size: 14px; text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .pc-cmp-cta .pc-cta-pill:hover { background: var(--pc-orange-dk, #D24E20); transform: translateY(-1px); }
  .pc-cmp-guarantee {
    font-family: var(--fdr-font-body, system-ui, sans-serif);
    font-size: 13px; color: var(--pc-muted, #8a8270); margin-top: 12px;
  }
</style>

<div class="pc-cmp">
  {%- if eyebrow != blank -%}<p class="pc-eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
  {%- if heading != blank -%}<h2 class="pc-h2">{{ heading | escape }}</h2>{%- endif -%}
  {%- if subheading != blank -%}<p class="pc-sub">{{ subheading | escape }}</p>{%- endif -%}

  {%- comment -%} Desktop Table (4 columns) {%- endcomment -%}
  <div class="pc-cmp-wrap pc-cmp-wrap--desktop">
    <table class="pc-cmp-table">
      <colgroup>
        <col class="pc-cmp-c-attr">
        <col class="pc-cmp-c-comp1">
        <col class="pc-cmp-c-comp2">
        <col class="pc-cmp-c-gj">
      </colgroup>
      <thead>
        <tr>
          <th class="pc-cmp-th-empty"></th>
          <th class="pc-cmp-th-comp">
            {%- if col_comp1_label != blank -%}<span class="pc-cmp-th-label">{{ col_comp1_label }}</span>{%- endif -%}
            {%- if col_comp1_sub != blank -%}<span class="pc-cmp-th-sub">{{ col_comp1_sub }}</span>{%- endif -%}
          </th>
          <th class="pc-cmp-th-comp">
            {%- if col_comp2_label != blank -%}<span class="pc-cmp-th-label">{{ col_comp2_label }}</span>{%- endif -%}
            {%- if col_comp2_sub != blank -%}<span class="pc-cmp-th-sub">{{ col_comp2_sub }}</span>{%- endif -%}
          </th>
          <th class="pc-cmp-th-gj">
            {%- if col_gj_label != blank -%}<span class="pc-cmp-th-label pc-cmp-th-label--gj">&#9733; {{ col_gj_label }}</span>{%- endif -%}
            {%- if col_gj_sub != blank -%}<span class="pc-cmp-th-sub pc-cmp-th-sub--gj">{{ col_gj_sub }}</span>{%- endif -%}
          </th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          {%- if block.type == 'comparison_row' -%}
            <tr {{ block.shopify_attributes }}>
              <td class="pc-cmp-attr">{{ block.settings.feature | escape }}</td>
              <td class="pc-cmp-val-comp">
                {%- if block.settings.comp1_value != blank -%}{{ block.settings.comp1_value }}{%- else -%}<span class="pc-cmp-x">&#10007;</span>{%- endif -%}
              </td>
              <td class="pc-cmp-val-comp">
                {%- if block.settings.comp2_value != blank -%}{{ block.settings.comp2_value }}{%- else -%}<span class="pc-cmp-x">&#10007;</span>{%- endif -%}
              </td>
              <td class="pc-cmp-val-gj">
                {%- if block.settings.gj_has_check -%}<span class="pc-cmp-check">&#10003;</span>
                {%- elsif block.settings.gj_value != blank -%}<span class="pc-cmp-win">{{ block.settings.gj_value }}</span>
                {%- else -%}<span class="pc-cmp-check">&#10003;</span>{%- endif -%}
              </td>
            </tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>

  {%- comment -%} Mobile Table (3 columns) {%- endcomment -%}
  <div class="pc-cmp-wrap pc-cmp-wrap--mobile">
    <table class="pc-cmp-table">
      <colgroup>
        <col class="pc-cmp-c-attr">
        <col class="pc-cmp-c-comp">
        <col class="pc-cmp-c-gj">
      </colgroup>
      <thead>
        <tr>
          <th class="pc-cmp-th-empty"></th>
          <th class="pc-cmp-th-comp">
            {%- if col_mobile_comp_label != blank -%}<span class="pc-cmp-th-label">{{ col_mobile_comp_label }}</span>{%- endif -%}
          </th>
          <th class="pc-cmp-th-gj">
            {%- if col_mobile_gj_label != blank -%}<span class="pc-cmp-th-label pc-cmp-th-label--gj">&#9733; {{ col_mobile_gj_label }}</span>{%- endif -%}
            {%- if col_mobile_gj_sub != blank -%}<span class="pc-cmp-th-sub pc-cmp-th-sub--gj">{{ col_mobile_gj_sub }}</span>{%- endif -%}
          </th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          {%- if block.type == 'comparison_row' -%}
            <tr {{ block.shopify_attributes }}>
              <td class="pc-cmp-attr">{{ block.settings.feature | escape }}</td>
              <td class="pc-cmp-val-comp"><span class="pc-cmp-x">&#10007;</span></td>
              <td class="pc-cmp-val-gj">
                {%- if block.settings.gj_has_check -%}<span class="pc-cmp-check">&#10003;</span>
                {%- elsif block.settings.gj_value != blank -%}<span class="pc-cmp-win">{{ block.settings.gj_value }}</span>
                {%- else -%}<span class="pc-cmp-check">&#10003;</span>{%- endif -%}
              </td>
            </tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>

  {%- if bridge_text != blank -%}
    <p class="pc-cmp-bridge">{{ bridge_text | escape }}</p>
  {%- endif -%}

  {%- if cta_text != blank -%}
    <div class="pc-cmp-cta">
      <a href="{{ cta_url | default: '#buy-box' }}" class="pc-cta-pill">
        {{ cta_text | escape }}
        <svg width="18" height="13" viewBox="0 0 18 13" fill="none" aria-hidden="true"><path d="M1 6.5H17M17 6.5L11 1M17 6.5L11 12" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      {%- if guarantee != blank -%}<p class="pc-cmp-guarantee">{{ guarantee | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Pro Chews Comparison",
  "tag": "section",
  "class": "section-pc-cmp",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How We Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Probiotic chews are not all built the same" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Most chews are probiotic only. Get Joy carries the full system." },
    { "type": "header", "content": "Column Labels (Desktop)" },
    { "type": "text", "id": "col_comp1_label", "label": "Column 1 label", "default": "Most Probiotic Chews" },
    { "type": "text", "id": "col_comp1_sub", "label": "Column 1 sub" },
    { "type": "text", "id": "col_comp2_label", "label": "Column 2 label", "default": "\"Premium\" Chews" },
    { "type": "text", "id": "col_comp2_sub", "label": "Column 2 sub" },
    { "type": "text", "id": "col_gj_label", "label": "Get Joy label", "default": "Get Joy" },
    { "type": "text", "id": "col_gj_sub", "label": "Get Joy sub", "default": "Probiotic Chews" },
    { "type": "header", "content": "Column Labels (Mobile)" },
    { "type": "text", "id": "col_mobile_comp_label", "label": "Mobile competitor label", "default": "Other Chews" },
    { "type": "text", "id": "col_mobile_gj_label", "label": "Mobile Get Joy label", "default": "Get Joy" },
    { "type": "text", "id": "col_mobile_gj_sub", "label": "Mobile Get Joy sub", "default": "Probiotic Chews" },
    { "type": "header", "content": "Bridge & CTA" },
    { "type": "text", "id": "bridge_text", "label": "Bridge text below table", "default": "Most probiotic chews are probiotic only. Get Joy carries the whole system: probiotic, postbiotic, prebiotic, omega, and gut-lining support." },
    { "type": "text", "id": "cta_text", "label": "CTA button text", "default": "Add to Cart — $25.99" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "30-day money-back guarantee. If your dog won't eat them, we'll refund you." }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Feature name" },
        { "type": "text", "id": "comp1_value", "label": "Column 1 value (blank = ✗)" },
        { "type": "text", "id": "comp2_value", "label": "Column 2 value (blank = ✗)" },
        { "type": "text", "id": "gj_value", "label": "Get Joy value (blank = ✓)" },
        { "type": "checkbox", "id": "gj_has_check", "label": "Show ✓ only (no text)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pro Chews Comparison",
      "category": "Landing Page",
      "blocks": [
        { "type": "comparison_row", "settings": { "feature": "Live CFU disclosed", "comp1_value": "Sometimes", "comp2_value": "Usually", "gj_value": "3 billion, listed" }},
        { "type": "comparison_row", "settings": { "feature": "Postbiotic included", "comp2_value": "Sometimes", "gj_value": "200mg" }},
        { "type": "comparison_row", "settings": { "feature": "Pre + pro + postbiotic", "comp1_value": "Rare", "comp2_value": "Sometimes", "gj_value": "All 3 layers" }},
        { "type": "comparison_row", "settings": { "feature": "Omega-3 (algae)", "gj_value": "DHA 46 + EPA 31" }},
        { "type": "comparison_row", "settings": { "feature": "L-Glutamine for gut lining", "comp2_value": "Rare", "gj_value": "100mg" }},
        { "type": "comparison_row", "settings": { "feature": "Made in USA", "comp1_value": "Varies", "comp2_value": "Usually", "gj_value": "Always" }},
        { "type": "comparison_row", "settings": { "feature": "30-day money-back guarantee", "comp1_value": "Sometimes", "comp2_value": "Sometimes", "gj_has_check": true }}
      ]
    }
  ]
}
{% endschema %}
