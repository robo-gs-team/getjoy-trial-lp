{{ 'fdr-trial-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign eyebrow       = section.settings.eyebrow
  assign headline      = section.settings.headline
  assign quote_text    = section.settings.quote_text
  assign person_name   = section.settings.person_name
  assign person_title  = section.settings.person_title
  assign badge_text    = section.settings.badge_text
  assign date_text     = section.settings.date_text
  assign video_url     = section.settings.video_url
  assign dog_pill_text = section.settings.dog_pill_text
-%}

<style>
/* ── NPH Section ── */
.pc-nph-section {
  position: relative; overflow: hidden; width: 100%;
  padding: 80px 20px;
  background: radial-gradient(ellipse 70% 80% at 25% 50%, #006b08 0%, #004004 45%, #002802 100%);
}
.pc-nph-inner {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: 52% 1fr;
  gap: 64px; align-items: center;
}

/* ── Left: video wrapper ── */
.pc-nph-vid-wrap {
  position: relative; overflow: hidden;
  border-radius: 20px;
  box-shadow: 0 40px 100px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.07);
}
.pc-nph-vid-wrap video {
  display: block; width: 100%;
  object-fit: cover; max-height: 600px;
}
.pc-nph-vid-wrap::after {
  content: '';
  position: absolute; bottom: 0; left: 0; right: 0; height: 45%;
  background: linear-gradient(to top, rgba(0,20,0,.92) 0%, rgba(0,20,0,.45) 40%, transparent 100%);
  pointer-events: none; z-index: 2;
  border-radius: 0 0 20px 20px;
}
.pc-nph-dog-pill {
  position: absolute; bottom: 20px; left: 20px; z-index: 3;
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(0,0,0,.45);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 100px; padding: 9px 16px;
  font-family: var(--fdr-font-body); font-weight: 600;
  font-size: 12.5px; color: rgba(255,255,255,.90); letter-spacing: .01em;
}
.pc-nph-dog-pill svg { flex-shrink: 0; }

/* ── Right: content ── */
.pc-nph-content { display: flex; flex-direction: column; gap: 0; }
.pc-nph-eyebrow {
  font-family: var(--fdr-font-body); font-weight: 700;
  font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
  color: var(--pc-orange, #E85F2E); margin-bottom: 16px;
}
.pc-nph-headline {
  font-family: var(--fdr-font-heading); font-weight: 900;
  font-size: 40px; line-height: 1.08; letter-spacing: -.02em;
  color: #fff; margin-bottom: 28px; max-width: 440px;
}
.pc-nph-quote-block {
  margin-bottom: 28px; padding-left: 22px;
  border-left: 3px solid var(--pc-orange, #E85F2E); position: relative;
  max-width: 460px;
}
.pc-nph-quote {
  font-family: var(--fdr-font-serif); font-style: italic; font-weight: 400;
  font-size: 17px; line-height: 1.7; color: rgba(255,255,255,.88);
}
.pc-nph-identity {
  display: flex; align-items: center; gap: 16px; margin-bottom: 20px;
}
.pc-nph-rule {
  width: 1.5px; height: 44px; flex-shrink: 0;
  background: rgba(255,255,255,.15);
}
.pc-nph-name {
  font-family: var(--fdr-font-heading); font-weight: 900;
  font-size: 20px; color: #fff; letter-spacing: -.01em; line-height: 1.1;
}
.pc-nph-title {
  font-family: var(--fdr-font-body); font-weight: 400;
  font-size: 13px; color: rgba(255,255,255,.45); margin-top: 3px;
}
.pc-nph-badge {
  display: inline-flex; align-items: center; width: fit-content;
  background: rgba(232,95,46,.10); border: 1px solid rgba(232,95,46,.30);
  border-radius: 6px; padding: 7px 14px;
  font-family: var(--fdr-font-body); font-weight: 700;
  font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase;
  color: var(--pc-orange, #E85F2E); margin-bottom: 16px;
}
.pc-nph-date {
  font-family: var(--fdr-font-body); font-weight: 400;
  font-size: 13px; color: rgba(255,255,255,.30); letter-spacing: .02em;
}

/* ── Eyebrow overlay (mobile only) ── */
.pc-nph-eyebrow-overlay {
  display: none;
}

/* ── Mobile ── */
@media (max-width: 768px) {
  .pc-nph-section {
    padding: 72px 20px;
  }
  .pc-nph-inner { grid-template-columns: 1fr; gap: 36px; }
  .pc-nph-vid-wrap video { aspect-ratio: 4/5; max-height: 420px; }
  .pc-nph-headline { font-size: 26px; line-height: 1.1; }
  .pc-nph-quote { font-size: 16px; }
  .pc-nph-name { font-size: 18px; }
  .pc-nph-content { padding: 0 4px; }
  /* hide original eyebrow, show overlay */
  .pc-nph-eyebrow { display: none; }
  .pc-nph-eyebrow-overlay {
    display: block;
    position: absolute; top: 16px; left: 16px; z-index: 3;
    background: rgba(0,0,0,0.40);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border-radius: 100px; padding: 7px 14px;
    font-family: var(--fdr-font-body); font-weight: 700;
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--pc-orange, #E85F2E);
  }
}
</style>

<div class="pc-nph-inner">

  <!-- Left: Video -->
  {%- if video_url != blank -%}
    <div class="pc-nph-vid-wrap">
      <video autoplay muted loop playsinline>
        <source src="{{ video_url }}" type="video/mp4">
      </video>
      {%- if dog_pill_text != blank -%}
        <div class="pc-nph-dog-pill">
          <svg width="14" height="14" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2.7,8.29s.5.47,1.45,1.02c.37.21.81.43,1.32.64,1.35.56,3.19,1.05,5.53,1.05,1.49,0,2.77-.2,3.86-.49,1.28-.34,2.29-.8,3.02-1.22.92-.53,1.39-.98,1.42-1l.19-.2s.01-.06.01-.09c0-1.66-1.34-3-3-3-.22,0-.44.02-.65.07-.39-1.2-1.52-2.07-2.85-2.07-.72,0-1.38.26-1.9.68-.56-1-1.63-1.68-2.85-1.68-1.71,0-3.11,1.33-3.23,3h-.02c-1.38,0-2.5,1.12-2.5,2.5,0,.24.03.47.1.69l.1.1Z" fill="#fff"/>
            <path d="M20,9s-.39.39-1.17.89c-.27.17-.59.36-.95.54-.37.2-.79.39-1.26.56-1.42.56-3.3,1.01-5.62,1.01-3.07,0-5.36-.79-6.85-1.55-1.43-.73-2.15-1.45-2.15-1.45l-2,7s2.5,4,11,4,11-4,11-4l-2-7ZM11,18s-2-1.64-2-2.91c0-.64.29-1.09,1-1.09.64,0,1,.73,1,.73,0,0,.36-.73,1-.73.71,0,1,.45,1,1.09,0,1.27-2,2.91-2,2.91Z" fill="#fff"/>
          </svg>
          {{ dog_pill_text }}
        </div>
      {%- endif -%}
      {%- if eyebrow != blank -%}
        <span class="pc-nph-eyebrow-overlay">{{ eyebrow | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <!-- Right: Content -->
  <div class="pc-nph-content">
    {%- if eyebrow != blank -%}
      <p class="pc-nph-eyebrow">{{ eyebrow | escape }}</p>
    {%- endif -%}

    {%- if headline != blank -%}
      <h2 class="pc-nph-headline">{{ headline }}</h2>
    {%- endif -%}

    {%- if quote_text != blank -%}
      <div class="pc-nph-quote-block">
        <p class="pc-nph-quote">&ldquo;{{ quote_text | escape }}&rdquo;</p>
      </div>
    {%- endif -%}

    {%- if person_name != blank or person_title != blank -%}
      <div class="pc-nph-identity">
        <div class="pc-nph-rule"></div>
        <div>
          {%- if person_name != blank -%}
            <div class="pc-nph-name">{{ person_name | escape }}</div>
          {%- endif -%}
          {%- if person_title != blank -%}
            <div class="pc-nph-title">{{ person_title | escape }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if badge_text != blank -%}
      <span class="pc-nph-badge">{{ badge_text | escape }}</span>
    {%- endif -%}

    {%- if date_text != blank -%}
      <p class="pc-nph-date">{{ date_text | escape }}</p>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "Pro Chews NPH",
  "tag": "section",
  "class": "pc-nph-section",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (CDN mp4)",
      "default": "https://cdn.shopify.com/videos/c/o/v/ae953a0040e448edba859b2382a27d30.mp4"
    },
    {
      "type": "text",
      "id": "dog_pill_text",
      "label": "Dog names pill",
      "default": "Gidget, Spike, Chunk & Bianca"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "From Customer to Co-Owner"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>He fed his dogs Get Joy for 3 years.<br>Then he joined the mission.</p>"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote (without quotation marks)",
      "default": "Our dogs have been devouring Get Joy for the past three years. So, rather than just continuing to order the food, I decided to invest and become an owner. I\u2019m putting my money where their paws are."
    },
    {
      "type": "header",
      "content": "Identity"
    },
    {
      "type": "text",
      "id": "person_name",
      "label": "Name",
      "default": "Neil Patrick Harris"
    },
    {
      "type": "text",
      "id": "person_title",
      "label": "Title / role",
      "default": "Actor \u00b7 Writer \u00b7 Director"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Co-Owner & Investor \u2014 Get Joy"
    },
    {
      "type": "text",
      "id": "date_text",
      "label": "Date line",
      "default": "Customer since 2023 \u00b7 Investor since 2026"
    }
  ],
  "presets": [
    {
      "name": "Pro Chews NPH",
      "category": "Landing Page"
    }
  ]
}
{% endschema %}
