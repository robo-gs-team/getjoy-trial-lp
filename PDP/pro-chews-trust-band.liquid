{%- liquid
  assign background_color = section.settings.background_color
-%}

{{ 'fdr-trial-pdp.css' | asset_url | stylesheet_tag }}

<style>
  /* ─── TRUST BAND ─── */
  .pc-trust-band {
    background:var(--fdr-forest);
    display:flex;
  }
  .pc-trust-band__cell {
    flex:1;
    display:flex; align-items:center; justify-content:center; gap:10px;
    padding:15px 20px;
    border-right:1px solid rgba(255,255,255,0.12);
  }
  .pc-trust-band__cell:last-child { border-right:none; }
  .pc-trust-band__icon {
    width:30px; height:30px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
  }
  .pc-trust-band__icon svg { width:20px; height:20px; }
  .pc-trust-band__label {
    font-family:var(--fdr-font-body);
    font-size:12.5px; font-weight:700;
    color:#fff; line-height:1.2;
    white-space:nowrap;
  }
  .pc-trust-band__cell--hide-mobile {
    display:flex;
  }

  /* ══ TRUST BAND MARQUEE ══ */
  .pc-trust-band__track {
    overflow:hidden;
    width:100%;
    display:flex;
  }
  .pc-trust-band__inner {
    display:flex;
    width:max-content;
    animation:pc-tb-scroll 24s linear infinite;
  }
  .pc-trust-band__inner .pc-trust-band__cell {
    flex-shrink:0;
    min-width:280px;
  }
  @keyframes pc-tb-scroll {
    0%   { transform:translateX(0); }
    100% { transform:translateX(-50%); }
  }
  .pc-trust-band__track:hover .pc-trust-band__inner { animation-play-state:paused; }

  @media (max-width: 768px) {
    .pc-trust-band__cell--hide-mobile { display:none; }
    .pc-trust-band__inner .pc-trust-band__cell { min-width:240px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pc-trust-band__inner { animation:none; }
  }
</style>

<div class="pc-trust-band">
  <div class="pc-trust-band__track">
    {% for i in (1..2) %}
    <div class="pc-trust-band__inner"{% if i == 2 %} aria-hidden="true"{% endif %}>
      {% for block in section.blocks %}
        {%- liquid
          assign label = block.settings.label
          assign icon_svg = block.settings.icon_svg
          assign hide_mobile = block.settings.hide_mobile
        -%}
        <div class="pc-trust-band__cell{% if hide_mobile %} pc-trust-band__cell--hide-mobile{% endif %}" {{ block.shopify_attributes }}>
          {% if icon_svg != blank %}
            <div class="pc-trust-band__icon">{{ icon_svg }}</div>
          {% endif %}
          <span class="pc-trust-band__label">{{ label | escape }}</span>
        </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Pro Chews Trust Band",
  "tag": "section",
  "class": "section-pc-trust-band",
  "settings": [
    {
      "type": "select",
      "id": "background_color",
      "label": "Background color",
      "options": [
        { "value": "core-forest", "label": "Forest" },
        { "value": "core", "label": "Green" }
      ],
      "default": "core-forest"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Crafted in the USA"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Icon SVG code",
          "info": "Paste inline SVG markup for the icon"
        },
        {
          "type": "checkbox",
          "id": "hide_mobile",
          "label": "Hide on mobile",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pro Chews Trust Band",
      "category": "Landing Page",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "label": "Made in the USA",
            "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 22 22\" fill=\"none\"><path d=\"M11 2C7.69 2 5 4.69 5 8c0 4.5 6 12 6 12s6-7.5 6-12c0-3.31-2.69-6-6-6zm0 8.5c-1.38 0-2.5-1.12-2.5-2.5S9.62 5.5 11 5.5s2.5 1.12 2.5 2.5S12.38 10.5 11 10.5z\" fill=\"#fff\"/></svg>"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "3 billion live CFU, plus a postbiotic",
            "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 22 22\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8\" cy=\"8\" r=\"2.2\"/><circle cx=\"15\" cy=\"13\" r=\"2.6\"/><circle cx=\"8\" cy=\"15\" r=\"1.6\"/></svg>"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "All life stages, puppy through senior",
            "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 22 22\"><path fill=\"#fff\" d=\"M15.86,13.78c-1.94-2.18-2.08-4.28-4.86-4.28s-2.92,2.1-4.86,4.28c-1.83,2.06-3.64,2.62-3.64,5.07s1.77,3.15,3.86,3.15,2.67-1,4.64-1,2.56,1,4.64,1,3.86-.69,3.86-3.15-1.81-3.01-3.64-5.07Z\"/></svg>"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "NASC-quality ingredients",
            "hide_mobile": true,
            "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 22 22\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 1l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L11 16l-5.8 3 1.1-6.5L1.6 7.8l6.5-.9z\"/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
